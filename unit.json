{
    "listeners": {
        "*:8000": {
            "pass": "routes",
            "forwarded": {
                "protocol": "X-Forwarded-Proto",
                "source": [
                    "0.0.0.0/0"
                ]
            }
        }
    },
    "routes": [
        {
            "match": {
                "uri": "/index.php"
            },
            "action": {
                "pass": "applications/laravel"
            }
        },
        {
            "match": {
                "uri": "!/index.php"
            },
            "action": {
                "share": "/app/public$uri",
                "fallback": {
                    "pass": "applications/laravel"
                }
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "root": "/app/public/",
            "script": "index.php",
            "user": "unit",
            "group": "unit"
        }
    }
}
