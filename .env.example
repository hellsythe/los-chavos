OPEN_AI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_VECTOR_SIZE=1536

CHAT_BOT_DEBOUNCE_SECONDS=5
CHAT_BOT_CONTEXT_TOP_K=5
CHAT_BOT_MAX_HISTORY=5

